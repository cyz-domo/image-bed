# 每个变量的取值来源见 docs/deployment.md 第 4 步。
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
# 私钥：整个 .pem 文件的 base64 拆三段（每段 <1000 字符，EdgeOne 限制）。
# 本地/无限制平台也可用单个 GITHUB_APP_PRIVATE_KEY_B64。
GITHUB_APP_PRIVATE_KEY_B64_1=
GITHUB_APP_PRIVATE_KEY_B64_2=
GITHUB_APP_PRIVATE_KEY_B64_3=
# openssl rand -hex 32
SESSION_SECRET=
PUBLIC_BASE_URL=https://images.example.com
# 图片仓库：存放 images/ 与 .state/ 的公开仓库，改成自己的
GITHUB_OWNER=my-name
GITHUB_REPO=my-images
ALLOWED_GITHUB_LOGIN=my-github-login
# 其他可登录上传的用户：GitHub 用户名或公开邮箱，逗号/空格分隔。
# 配置后以它为准，站点设置里的旧名单当场失效；留空则仍读站点设置中的「允许用户」。
ALLOWED_USERS=
MAX_FILE_SIZE=10485760
# 每日上传上限，超过后当天拒绝上传（429）
DAILY_UPLOAD_LIMIT=100
# KV 绑定在 EdgeOne 控制台配置（变量名 IMAGE_KV），此处无需填写
