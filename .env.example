GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
# 私钥：整个 .pem 文件的 base64 拆三段（每段 <1000 字符，EdgeOne 限制）。
# 本地/无限制平台也可用单个 GITHUB_APP_PRIVATE_KEY_B64。
GITHUB_APP_PRIVATE_KEY_B64_1=
GITHUB_APP_PRIVATE_KEY_B64_2=
GITHUB_APP_PRIVATE_KEY_B64_3=
# openssl rand -hex 32
SESSION_SECRET=
PUBLIC_BASE_URL=https://images.example.com
GITHUB_OWNER=cyz-domo
GITHUB_REPO=image-bed
ALLOWED_GITHUB_LOGIN=cyz-domo
MAX_FILE_SIZE=10485760
# 每日上传上限，超过后当天拒绝上传（429）
DAILY_UPLOAD_LIMIT=100
# KV 绑定在 EdgeOne 控制台配置（变量名 IMAGE_KV），此处无需填写
